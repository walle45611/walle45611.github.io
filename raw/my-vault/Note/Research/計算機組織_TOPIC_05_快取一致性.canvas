			"file": "Assets/Note/Research/計算機組織_TOPIC_05_快取一致性/19-計算機組織_TOPIC_05_快取一致性.png",
			"x": -3320,
			"y": 1752,
			"width": 548,
			"height": 303
		},
		{
			"id": "68afdc5f1e57b309",
			"type": "text",
			"text": "write update 所以基本上就是有 write 就會有在 bus 上 (資料)",
			"x": -2640,
			"y": 1479,
			"width": 250,
			"height": 60,
			"color": "1"
		},
		{
