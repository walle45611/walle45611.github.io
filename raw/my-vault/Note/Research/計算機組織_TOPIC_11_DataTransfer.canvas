		},
		{
			"id": "7f3ff381aa91eeb3",
			"type": "file",
			"file": "Assets/Note/Research/計算機組織_TOPIC_11_DataTransfer/15-DMA - 有四樣東西要做設定.png",
			"x": 2494,
