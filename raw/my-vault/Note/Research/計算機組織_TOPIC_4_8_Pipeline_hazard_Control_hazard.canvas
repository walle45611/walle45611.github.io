			"height": 323
		},
		{
			"id": "0458b5bf6ce8525a",
			"type": "file",
			"file": "Assets/Note/Research/計算機組織_TOPIC_4_8_Pipeline_hazard_Control_hazard/43-delayed branching - 這圖要會畫.png",
			"x": 5206,
