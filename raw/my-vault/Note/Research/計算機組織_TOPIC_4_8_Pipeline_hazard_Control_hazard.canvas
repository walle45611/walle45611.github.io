			"height": 60
		},
		{
			"id": "9842d0360e0a996b",
			"type": "file",
			"file": "Assets/Note/Research/計算機組織_TOPIC_4_8_Pipeline_hazard_Control_hazard/14-NOP - 需要等到 lw 真正 WB 的時線才能使用.png",
			"x": -1000,
			"y": 2799,
			"width": 400,
			"height": 220
