		},
		{
			"id": "1670b89f3bb348e7",
			"type": "file",
			"file": "Assets/Note/Research/計算機組織_TOPIC_4_8_Pipeline_hazard_Control_hazard/03-Structural hazard - 加一個 NOP.png",
