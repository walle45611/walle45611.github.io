			"file": "Assets/Note/Research/計算機組織_TOPIC_4_Cache_fundamental/04-Write Miss.png",
			"x": 2840,
			"y": -220,
			"width": 400,
			"height": 206
		},
		{
			"id": "2d18a6f14340209e",
			"type": "file",
			"file": "Assets/Note/Research/計算機組織_TOPIC_4_Cache_fundamental/16-Bandwithdth - 加寬 (圖 b).png",
